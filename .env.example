# Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Autenticación local (obligatoria con DEBUG=False).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=
# Cookie del refresh token: Secure por defecto cuando DEBUG=False.
# AUTH_COOKIE_SECURE=True

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=prefer

# Frontend / CORS (orígenes explícitos; se usan cookies con credenciales)
FRONTEND_URL=http://localhost:5173

# Operaciones técnicas
TECHNICAL_BACKUP_DIR=
TECHNICAL_ALLOW_RESTORE=False
